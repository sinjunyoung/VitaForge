<Window x:Class="VitaForge.Views.EnterButtonWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Common.Localization;assembly=Common"
        Title="{Binding Path=Current.TitleEnterButton, Source={x:Static l:Loc.Instance}}"
        Width="440" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#1E1E1E" Foreground="White">
    <StackPanel Margin="24">
        <RadioButton x:Name="CircleRadio" GroupName="EnterButton" FontSize="14" Margin="0,0,0,10" Checked="Radio_Checked"
                     Content="{Binding Path=Current.LabelEnterButtonCircle, Source={x:Static l:Loc.Instance}}"/>
        <RadioButton x:Name="CrossRadio" GroupName="EnterButton" FontSize="14" Checked="Radio_Checked"
                     Content="{Binding Path=Current.LabelEnterButtonCross, Source={x:Static l:Loc.Instance}}"/>
        <TextBlock x:Name="HintText" Foreground="#4DA6FF" FontSize="12" Margin="0,12,0,0" TextWrapping="Wrap" Visibility="Collapsed"
                   Text="{Binding Path=Current.HintEnterButtonCross, Source={x:Static l:Loc.Instance}}"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Style="{StaticResource GrayButton}" IsDefault="True" MinWidth="90" Height="30" Margin="0,0,8,0" Padding="10,0" Click="OkButton_Click"
                    Content="{Binding Path=Current.ButtonOk, Source={x:Static l:Loc.Instance}}"/>
            <Button Style="{StaticResource GrayButton}" IsCancel="True" MinWidth="90" Height="30" Padding="10,0"
                    Content="{Binding Path=Current.ButtonCancel, Source={x:Static l:Loc.Instance}}"/>
        </StackPanel>
    </StackPanel>
</Window>