<Window x:Class="VitaForge.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:VitaForge.Views"
        xmlns:psvita="clr-namespace:VitaForge.Controls.PSVita"
        xmlns:settings="clr-namespace:VitaForge.Controls.Settings"
        xmlns:vm="clr-namespace:VitaForge.ViewModels"
        xmlns:helpers="clr-namespace:VitaForge.Core.UI.Helpers;assembly=VitaForge.Core"
        xmlns:l="clr-namespace:Common.Localization;assembly=Common"
        Title="{Binding AppVersion}" Height="730" Width="900" MinHeight="730" MinWidth="900" Background="#1E1E1E" AllowDrop="True" FontFamily="Segoe UI">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" ResizeBorderThickness="5" GlassFrameThickness="1" CornerRadius="5"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="CaptionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3F3F46"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <DataTrigger Binding="{Binding IsActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                    <Setter Property="Foreground" Value="#7F7F7F"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CloseButtonStyle" TargetType="Button" BasedOn="{StaticResource CaptionButtonStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E81123"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Window.TaskbarItemInfo>
        <TaskbarItemInfo ProgressValue="{Binding TaskbarProgressValue}" ProgressState="{Binding TaskbarProgressState}" />
    </Window.TaskbarItemInfo>
    <Grid Background="#1E1E1E">
        <Grid.Style>
            <Style TargetType="Grid">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                        <Setter Property="Margin" Value="7"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="5"/>
            <RowDefinition x:Name="LogRow" Height="{Binding LogBoxHeight}" MinHeight="40"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Background="#252525">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Width="32" Height="32" Background="Transparent" BorderThickness="0" WindowChrome.IsHitTestVisibleInChrome="True" Click="IconBox_Click" MouseRightButtonUp="IconBox_MouseRightButtonUp">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <Image Source="{Binding AppIcon}" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
                <Button.Style>
                    <Style TargetType="Button">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3F3F46"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <TextBlock Grid.Column="1" Text="{Binding AppVersion}" VerticalAlignment="Center" Margin="5,0,0,0" FontSize="13">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="White"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                                <Setter Property="Foreground" Value="#7F7F7F"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <StackPanel Grid.Column="2" Orientation="Horizontal">                
                <Button Style="{StaticResource CaptionButtonStyle}" Click="MinimizeButton_Click">
                    <Path Data="M0,4 H10 V5 H0 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="10" Height="1" Stretch="Uniform"/>
                </Button>
                <Button x:Name="MaximizeButton" Click="MaximizeButton_Click">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource CaptionButtonStyle}">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}">
                                            <Path x:Name="IconPath" Stroke="{TemplateBinding Foreground}" StrokeThickness="1" Fill="Transparent" Width="10" Height="10" Stretch="Uniform" Data="M0,0 H10 V10 H0 Z"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                                                <Setter TargetName="IconPath" Property="Data" Value="M2,2 H8 V8 H2 Z M4,0 H10 V6 H8 V2 H4 Z"/>
                                            </DataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Style="{StaticResource CloseButtonStyle}" Click="CloseButton_Click">
                    <Path Data="M0,0 L10,10 M10,0 L0,10" 
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" 
                          StrokeThickness="1.3" 
                          Width="10" Height="10" Stretch="Uniform"/>
                </Button>
            </StackPanel>
        </Grid>
        <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex}">
            <TabItem IsEnabled="{Binding IsIdle}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Image Source="/Assets/Images/Vita.png" Width="20" Height="20" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="PS Vita" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <psvita:MainTab DataContext="{Binding PSVitaMainVM}"/>
            </TabItem>
            <TabItem IsEnabled="{Binding IsIdle}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/VitaForge.Core;component/Assets/Images/Settings.png" Width="20" Height="20" Margin="0,0,6,0" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Path=Current.TabSettings, Source={x:Static l:Loc.Instance}}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <settings:MainTab DataContext="{Binding Settings}" />
            </TabItem>
        </TabControl>
        <GridSplitter Grid.Row="2" Height="5" HorizontalAlignment="Stretch" Cursor="SizeNS" DragCompleted="GridSplitter_DragCompleted">
            <GridSplitter.Style>
                <Style TargetType="GridSplitter">
                    <Setter Property="Background" Value="#3A3A3A"/>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#0078D4"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter Property="Background" Value="#005A9E"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </GridSplitter.Style>
        </GridSplitter>
        <Border BorderBrush="#444444" BorderThickness="1" CornerRadius="10" Background="Transparent" Grid.Row="3">
            <ListBox x:Name="logBox" Style="{StaticResource LogBox}" ItemsSource="{Binding ActiveLogEntries}" helpers:LogAutoScrollBehavior.Enabled="True" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionMode="Extended" ContextMenuOpening="LogBox_ContextMenuOpening">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Focusable" Value="True"/>
                        <Setter Property="IsEnabled" Value="True"/>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="{Binding Path=Current.MenuClearLog, Source={x:Static l:Loc.Instance}}" Click="ClearLog_Click">
                            <MenuItem.Icon>
                                <Image Source="/Assets/Images/Clear.png" Width="24" Height="24" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{Binding Path=Current.MenuCopyLog, Source={x:Static l:Loc.Instance}}" Click="CopyLog_Click">
                            <MenuItem.Icon>
                                <Image Source="/Assets/Images/Copy.png" Width="24" Height="24" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </ListBox.ContextMenu>
            </ListBox>
        </Border>
    </Grid>
</Window>