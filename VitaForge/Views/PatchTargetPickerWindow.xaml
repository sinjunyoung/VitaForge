<Window x:Class="VitaForge.Views.PatchTargetPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Common.Localization;assembly=Common"
        Title="{Binding Path=Current.TitlePatchTargetPicker, Source={x:Static l:Loc.Instance}}"
        Height="620" Width="640"
        MinHeight="400" MinWidth="460"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#1E1E1E" Foreground="White">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock x:Name="HeaderText" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock x:Name="SubText" Foreground="#AAAAAA" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <Border Grid.Row="1" Background="#252526" BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="6" Padding="4">
            <TreeView x:Name="TargetTree" Background="Transparent" BorderThickness="0" Foreground="White" SelectedItemChanged="TargetTree_SelectedItemChanged" MouseDoubleClick="TargetTree_MouseDoubleClick" VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling">
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Glyph}" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding Name}"/>
                        </StackPanel>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
        </Border>

        <TextBlock x:Name="SelectedText" Grid.Row="2" Foreground="#4DA6FF" FontSize="12" Margin="0,10,0,0" TextTrimming="CharacterEllipsis"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Style="{StaticResource GrayButton}" Content="{Binding Path=Current.ButtonSkip, Source={x:Static l:Loc.Instance}}" Width="90" Height="34" Margin="0,0,8,0" IsCancel="True"/>
            <Button x:Name="SelectButton" Style="{StaticResource GrayButton}" Content="{Binding Path=Current.ButtonSelect, Source={x:Static l:Loc.Instance}}" Width="90" Height="34" IsDefault="True" IsEnabled="False" Click="SelectButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
