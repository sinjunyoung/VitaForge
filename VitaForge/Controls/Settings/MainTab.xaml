<UserControl x:Class="VitaForge.Controls.Settings.MainTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:VitaForge.Controls.Settings"
             xmlns:l="clr-namespace:Common.Localization;assembly=Common">
    <Grid>
        <TabControl SelectedIndex="{Binding SubTabIndex, Mode=TwoWay}" Background="Transparent" BorderThickness="0">
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="/VitaForge.Core;component/Assets/Images/Settings.png" Width="20" Height="20" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Path=Current.TabGeneral, Source={x:Static l:Loc.Instance}}" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <local:GeneralSettingsTab DataContext="{Binding General}" Margin="5,0,5,5"/>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
