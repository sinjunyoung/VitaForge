<UserControl x:Class="VitaForge.Controls.Settings.VitaSettingsTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Common.Localization;assembly=Common">
    <StackPanel>
        <Grid Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Background="#12FFFFFF" BorderBrush="#30FFFFFF" BorderThickness="1" CornerRadius="6" Grid.Column="0" Height="36">
                <Grid>
                    <TextBox Background="Transparent" BorderThickness="0" FontSize="11" Foreground="#DCDCDC" Padding="10,0" Text="{Binding DownloadPath, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" AllowDrop="True" PreviewDragOver="TxtDownloadPath_PreviewDragOver" Drop="TxtDownloadPath_Drop"/>
                    <TextBlock FontSize="11" Foreground="#50FFFFFF" IsHitTestVisible="False" Margin="10,0,0,0" Text="{Binding DownloadHint}" VerticalAlignment="Center" Visibility="{Binding DownloadHintVisibility}"/>
                </Grid>
            </Border>
            <Button BorderThickness="1" Command="{Binding BrowseDownloadPathCommand}" Grid.Column="1" Height="30" Margin="5,0,0,0" Padding="0" Style="{StaticResource GrayButton}" Width="30">
                <Image Height="30" RenderOptions.BitmapScalingMode="HighQuality" Source="/Assets/Images/AddFolder.png" Width="30"/>
            </Button>
        </Grid>

        <ToggleButton Style="{StaticResource SlideToggleStyle}" IsChecked="{Binding DeleteAfterInstall}">
            <StackPanel Orientation="Horizontal">
                <Image Width="24" Margin="0,0,10,0" Source="/Assets/Images/Delete.png"/>
                <TextBlock Text="{Binding Path=Current.ToggleDeleteDownloadsAfterInstall, Source={x:Static l:Loc.Instance}}" Style="{StaticResource SettingTextStyle}"/>
            </StackPanel>
        </ToggleButton>
    </StackPanel>
</UserControl>