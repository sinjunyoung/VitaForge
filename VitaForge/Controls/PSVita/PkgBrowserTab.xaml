<UserControl x:Class="VitaForge.Controls.PSVita.PkgBrowserTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Common.Localization;assembly=Common"
             PreviewMouseDown="Root_PreviewMouseDown">
    <UserControl.Resources>
        <Style x:Key="BtnIconStyle" TargetType="Image">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsEnabled, RelativeSource={RelativeSource AncestorType=Button}}" Value="False">
                    <Setter Property="Opacity" Value="0.35"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DrawingImage x:Key="IconBack">
            <DrawingImage.Drawing>
                <DrawingGroup ClipGeometry="M0,0 L24,0 L24,24 L0,24 Z">
                    <GeometryDrawing Geometry="M19,12 L5,12 M11,6 L5,12 L11,18">
                        <GeometryDrawing.Pen>
                            <Pen Brush="#E0E0E0" EndLineCap="Round" LineJoin="Round" StartLineCap="Round" Thickness="2"/>
                        </GeometryDrawing.Pen>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingImage.Drawing>
        </DrawingImage>

        <DrawingImage x:Key="IconForward">
            <DrawingImage.Drawing>
                <DrawingGroup ClipGeometry="M0,0 L24,0 L24,24 L0,24 Z">
                    <GeometryDrawing Geometry="M5,12 L19,12 M13,6 L19,12 L13,18">
                        <GeometryDrawing.Pen>
                            <Pen Brush="#E0E0E0" EndLineCap="Round" LineJoin="Round" StartLineCap="Round" Thickness="2"/>
                        </GeometryDrawing.Pen>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingImage.Drawing>
        </DrawingImage>

        <DrawingImage x:Key="IconUp">
            <DrawingImage.Drawing>
                <DrawingGroup ClipGeometry="M0,0 L24,0 L24,24 L0,24 Z">
                    <GeometryDrawing Geometry="M12,19 L12,5 M6,11 L12,5 L18,11">
                        <GeometryDrawing.Pen>
                            <Pen Brush="#E0E0E0" EndLineCap="Round" LineJoin="Round" StartLineCap="Round" Thickness="2"/>
                        </GeometryDrawing.Pen>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingImage.Drawing>
        </DrawingImage>

        <ContextMenu x:Key="SaveAllMenu">
            <MenuItem Header="{Binding Path=Current.MenuSaveAllRaw, Source={x:Static l:Loc.Instance}}" Click="MenuSaveAllRaw_Click">
                <MenuItem.Icon>
                    <Image Height="20" Source="/Assets/Images/LockSaveFile.png" Width="20"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{Binding Path=Current.MenuSaveAllDecrypted, Source={x:Static l:Loc.Instance}}" Click="MenuSaveAllDecrypted_Click">
                <MenuItem.Icon>
                    <Image Height="20" Source="/Assets/Images/UnlockSaveFile.png" Width="20"/>
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>

        <ContextMenu x:Key="SaveCheckedMenu">
            <MenuItem Header="{Binding Path=Current.MenuSaveCheckedRaw, Source={x:Static l:Loc.Instance}}" Click="MenuSaveCheckedRaw_Click">
                <MenuItem.Icon>
                    <Image Height="20" Source="/Assets/Images/LockSaveFile.png" Width="20"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{Binding Path=Current.MenuSaveCheckedDecrypted, Source={x:Static l:Loc.Instance}}" Click="MenuSaveCheckedDecrypted_Click">
                <MenuItem.Icon>
                    <Image Height="20" Source="/Assets/Images/UnlockSaveFile.png" Width="20"/>
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>

        <ContextMenu x:Key="ItemMenu" x:Shared="False">
            <MenuItem Header="{Binding Path=Current.MenuSaveAsRaw, Source={x:Static l:Loc.Instance}}" Click="MenuSaveAsRaw_Click">
                <MenuItem.Icon>
                    <Image Height="20" Source="/Assets/Images/LockSaveFile.png" Width="20"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{Binding Path=Current.MenuSaveAsDecrypted, Source={x:Static l:Loc.Instance}}" Click="MenuSaveAsDecrypted_Click">
                <MenuItem.Icon>
                    <Image Height="20" Source="/Assets/Images/UnlockSaveFile.png" Width="20"/>
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="#12FFFFFF" BorderBrush="#30FFFFFF" BorderThickness="1" CornerRadius="6" Grid.Row="0" IsEnabled="{Binding IsIdle}" Margin="5,0,5,5">
            <Grid Height="36">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button BorderThickness="1" Command="{Binding BackCommand}" Grid.Column="0" Height="28" Margin="4,0,0,0" Padding="0" Style="{StaticResource GrayButton}" Width="28">
                    <Image Height="16" Source="{StaticResource IconBack}" Style="{StaticResource BtnIconStyle}" Width="16"/>
                </Button>
                <Button BorderThickness="1" Command="{Binding ForwardCommand}" Grid.Column="1" Height="28" Margin="4,0,0,0" Padding="0" Style="{StaticResource GrayButton}" Width="28">
                    <Image Height="16" Source="{StaticResource IconForward}" Style="{StaticResource BtnIconStyle}" Width="16"/>
                </Button>
                <Button BorderThickness="1" Command="{Binding UpCommand}" Grid.Column="2" Height="28" Margin="4,0,8,0" Padding="0" Style="{StaticResource GrayButton}" Width="28">
                    <Image Height="16" Source="{StaticResource IconUp}" Style="{StaticResource BtnIconStyle}" Width="16"/>
                </Button>
                <TextBlock FontSize="12" Foreground="#DCDCDC" Grid.Column="3" Text="{Binding DisplayPath}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#4CAF50" Grid.Column="4" Margin="8,0,10,0" Text="{Binding CheckedText}" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <Border Background="#12FFFFFF" BorderBrush="#30FFFFFF" BorderThickness="1" CornerRadius="8" Grid.Row="1" IsEnabled="{Binding IsIdle}" Margin="5,0,5,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="230"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TreeView Background="Transparent" BorderThickness="0" Grid.Column="0" ItemsSource="{Binding TreeRoots}" Margin="5">
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                            <Setter Property="Foreground" Value="#E8E8F0"/>
                        </Style>
                    </TreeView.ItemContainerStyle>
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                            <StackPanel Orientation="Horizontal">
                                <Image Height="16" Margin="0,0,6,0" Source="/Assets/Images/Folder.png" Width="16"/>
                                <TextBlock FontSize="12" Text="{Binding Name}"/>
                            </StackPanel>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>

                <GridSplitter Background="#30FFFFFF" Grid.Column="1" HorizontalAlignment="Stretch" Width="1"/>

                <Grid Grid.Column="2">
                    <ListView x:Name="LvItems" AllowDrop="True" Background="Transparent" BorderThickness="0" ItemsSource="{Binding Items}" Margin="5" SelectionMode="Extended"
                              DragEnter="Root_DragEnter" Drop="Root_Drop" KeyUp="LvItems_KeyUp" MouseDoubleClick="LvItems_MouseDoubleClick">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
                                <EventSetter Event="PreviewMouseRightButtonDown" Handler="Item_PreviewMouseRightButtonDown"/>
                                <Setter Property="ContextMenu" Value="{StaticResource ItemMenu}"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Width="Auto">
                                    <GridViewColumn.Header>
                                        <CheckBox Style="{StaticResource SplitCheckBoxStyle}" Click="HeaderCheck_Click" HorizontalAlignment="Center" IsChecked="{Binding DataContext.AreCurrentChecked, RelativeSource={RelativeSource AncestorType=ListView}, Mode=OneWay}"/>
                                    </GridViewColumn.Header>
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox Style="{StaticResource SplitCheckBoxStyle}" HorizontalAlignment="Center" IsChecked="{Binding IsChecked, Mode=TwoWay}" IsEnabled="{Binding IsCheckEnabled}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Width="400">
                                    <GridViewColumn.Header>
                                        <GridViewColumnHeader Tag="TitleId">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Image Source="/Assets/Images/AddFile.png" Width="24" Height="24" Margin="0,0,4,0"/>
                                                <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#BBBBBB" Text="{Binding Path=Current.HeaderFileName, Source={x:Static l:Loc.Instance}}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </GridViewColumnHeader>
                                    </GridViewColumn.Header>
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Image Height="20" Margin="0,0,8,0" Source="{Binding IconSource}" Width="20"/>
                                                <TextBlock FontSize="12" Foreground="#E8E8F0" Text="{Binding Name}" ToolTip="{Binding FullPath}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Width="70">
                                    <GridViewColumn.Header>
                                        <GridViewColumnHeader Tag="Size">
                                            <Image Source="/Assets/Images/FileSizeBytes.png" Width="24" Height="24" Margin="0,0,4,0"/>
                                        </GridViewColumnHeader>
                                    </GridViewColumn.Header>
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock HorizontalAlignment="Right" Text="{Binding SizeText}" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Width="40">
                                    <GridViewColumn.Header>
                                        <Image Height="16" Source="/VitaForge.Core;component/Assets/Images/Lock.png" Width="16"/>
                                    </GridViewColumn.Header>
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Image Height="16" HorizontalAlignment="Center" Source="{Binding IsEncrypted, Converter={StaticResource LockIconConverter}}" Visibility="{Binding LockIconVisibility}" Width="16"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <Border BorderBrush="#333337" BorderThickness="1" CornerRadius="6" IsHitTestVisible="False" Margin="15,55,15,15" Visibility="{Binding EntriesHintVisibility}">
                        <Border.Background>
                            <SolidColorBrush Color="#181818" Opacity="0.95"/>
                        </Border.Background>
                        <StackPanel HorizontalAlignment="Center" Opacity="0.85" VerticalAlignment="Center">
                            <Image Height="28" Margin="0,0,0,8" Source="/Assets/Images/Info.png" Width="28"/>
                            <TextBlock FontSize="14" FontWeight="Bold" Foreground="LightGray" HorizontalAlignment="Center" Text="{Binding Path=Current.HintDropPkgFile, Source={x:Static l:Loc.Instance}}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <Border Background="#12FFFFFF" BorderBrush="#30FFFFFF" BorderThickness="1" CornerRadius="6" Grid.Row="2" Height="36" Margin="5,0,5,5">
            <Grid>
                <TextBox AllowDrop="True" Background="Transparent" BorderThickness="0" FontSize="11" Foreground="#DCDCDC" IsEnabled="{Binding IsIdle}" Padding="10,0" Text="{Binding License, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center"
                         Drop="License_Drop" PreviewDragOver="License_PreviewDragOver"/>
                <TextBlock FontSize="11" Foreground="#50FFFFFF" IsHitTestVisible="False" Margin="10,0,0,0" Text="{Binding Path=Current.ToolTipLicenseKey, Source={x:Static l:Loc.Instance}}" VerticalAlignment="Center" Visibility="{Binding LicenseHintVisibility}"/>
            </Grid>
        </Border>

        <Grid Grid.Row="3" IsEnabled="{Binding IsIdle}" Margin="5,0,5,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button BorderThickness="1" Command="{Binding AddCommand}" Grid.Column="0" Height="36" Margin="0,0,5,0" Style="{StaticResource GrayButton}">
                <StackPanel Orientation="Horizontal">
                    <Image Height="20" Margin="0,0,6,0" Source="/Assets/Images/AddFile.png" Width="20"/>
                    <TextBlock Text="{Binding Path=Current.ButtonAddFile, Source={x:Static l:Loc.Instance}}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button BorderThickness="1" Command="{Binding ClearCommand}" Grid.Column="1" Height="36" Margin="0,0,5,0" Style="{StaticResource GrayButton}">
                <StackPanel Orientation="Horizontal">
                    <Image Height="20" Margin="0,0,6,0" Source="/Assets/Images/Clear.png" Width="20"/>
                    <TextBlock Text="{Binding Path=Current.ButtonClear, Source={x:Static l:Loc.Instance}}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button BorderThickness="1" Command="{Binding UncheckAllCommand}" Grid.Column="2" Height="36" Margin="0,0,5,0" Style="{StaticResource GrayButton}">
                <StackPanel Orientation="Horizontal">
                    <Image Height="20" Margin="0,0,6,0" Source="/Assets/Images/Unchecked.png" Style="{StaticResource BtnIconStyle}" Width="20"/>
                    <TextBlock Text="{Binding Path=Current.ButtonUncheckAll, Source={x:Static l:Loc.Instance}}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button x:Name="BtnSaveChecked" BorderThickness="1" Click="BtnSaveChecked_Click" Grid.Column="3" Height="36" IsEnabled="{Binding HasChecked}" Margin="0,0,5,0" Style="{StaticResource GrayButton}">
                <StackPanel Orientation="Horizontal">
                    <Image Height="20" Margin="0,0,6,0" Source="/Assets/Images/CheckedSaveFile.png" Style="{StaticResource BtnIconStyle}" Width="20"/>
                    <TextBlock Text="{Binding Path=Current.ButtonSaveChecked, Source={x:Static l:Loc.Instance}}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button x:Name="BtnSaveAll" BorderThickness="1" Click="BtnSaveAll_Click" Grid.Column="4" Height="36" Style="{StaticResource GrayButton}">
                <StackPanel Orientation="Horizontal">
                    <Image Height="20" Margin="0,0,6,0" Source="/Assets/Images/SaveAll.png" Width="20"/>
                    <TextBlock Text="{Binding Path=Current.ButtonSaveAll, Source={x:Static l:Loc.Instance}}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <Border Background="#12FFFFFF" BorderBrush="#30FFFFFF" BorderThickness="0,1,0,0" CornerRadius="8" Grid.Row="4" Margin="5,0,5,5" Padding="8,0">
            <Grid Height="28">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock FontSize="11" Foreground="#A0A0A0" Grid.Column="0" Text="{Binding ProgressLabel}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#4CAF50" Grid.Column="1" Margin="0,0,10,0" Text="{Binding ProgressPercent}" VerticalAlignment="Center"/>
                <TextBlock FontSize="11" Foreground="Gray" Grid.Column="2" Margin="0,0,10,0" Text="{Binding ProgressSpeed}" VerticalAlignment="Center"/>
                <TextBlock FontSize="11" Foreground="#4CAF50" Grid.Column="3" Margin="0,0,10,0" Text="{Binding ProgressTime}" VerticalAlignment="Center"/>
                <Grid Grid.Column="4" Height="10" VerticalAlignment="Center">
                    <Border Background="#25FFFFFF" CornerRadius="5"/>
                    <Border ClipToBounds="True" CornerRadius="5" x:Name="barTrack">
                        <Border Background="#4CAF50" CornerRadius="5" HorizontalAlignment="Left">
                            <Border.Width>
                                <MultiBinding Converter="{StaticResource ProgressToWidthConverter}">
                                    <Binding ElementName="barTrack" Path="ActualWidth"/>
                                    <Binding Path="ProgressPct"/>
                                </MultiBinding>
                            </Border.Width>
                        </Border>
                    </Border>
                </Grid>
                <Button BorderThickness="1" Command="{Binding CancelCommand}" Content="{Binding Path=Current.ButtonCancel, Source={x:Static l:Loc.Instance}}" FontSize="11" Grid.Column="5" IsEnabled="{Binding IsLocked}" Margin="8,0,0,0" Padding="10,0" Style="{StaticResource GrayButton}"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
