<UserControl x:Class="VitaForge.Controls.PSVita.PkgBrowserTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Common.Localization;assembly=Common">
    <UserControl.Resources>
        <ContextMenu x:Key="SaveAllMenu">
            <MenuItem Header="{Binding Path=Current.MenuSaveAllRaw, Source={x:Static l:Loc.Instance}}" Click="MenuSaveAllRaw_Click"/>
            <MenuItem Header="{Binding Path=Current.MenuSaveAllDecrypted, Source={x:Static l:Loc.Instance}}" Click="MenuSaveAllDecrypted_Click"/>
        </ContextMenu>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="#12FFFFFF" BorderBrush="#30FFFFFF" BorderThickness="1" CornerRadius="6" Grid.Row="0" IsEnabled="{Binding IsIdle}" Margin="5,0,5,5">
            <Grid Height="36">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button BorderThickness="1" Command="{Binding UpCommand}" Content="↑" FontSize="16" Height="28" Margin="4,0,6,0" Padding="0" Style="{StaticResource GrayButton}" Width="28"/>
                <TextBlock FontSize="12" Foreground="#DCDCDC" Grid.Column="1" Text="{Binding DisplayPath}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <Border Background="#12FFFFFF" BorderBrush="#30FFFFFF" BorderThickness="1" CornerRadius="8" Grid.Row="1" IsEnabled="{Binding IsIdle}" Margin="5,0,5,5">
            <Grid>
                <ListView x:Name="LvItems" AllowDrop="True" Background="Transparent" BorderThickness="0" ItemsSource="{Binding Items}" Margin="5" SelectionMode="Extended"
                          ContextMenuOpening="LvItems_ContextMenuOpening" DragEnter="Root_DragEnter" Drop="Root_Drop" KeyUp="LvItems_KeyUp" MouseDoubleClick="LvItems_MouseDoubleClick">
                    <ListView.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="{Binding Path=Current.MenuSaveAsRaw, Source={x:Static l:Loc.Instance}}" Click="MenuSaveAsRaw_Click"/>
                            <MenuItem Header="{Binding Path=Current.MenuSaveAsDecrypted, Source={x:Static l:Loc.Instance}}" Click="MenuSaveAsDecrypted_Click"/>
                        </ContextMenu>
                    </ListView.ContextMenu>
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Width="460">
                                <GridViewColumn.Header>
                                    <TextBlock FontSize="13" FontWeight="Bold" Foreground="#BBBBBB" Text="{Binding Path=Current.HeaderFileName, Source={x:Static l:Loc.Instance}}"/>
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Image Height="20" Margin="0,0,8,0" Source="{Binding IconSource}" Width="20"/>
                                            <TextBlock FontSize="12" Foreground="#E8E8F0" Text="{Binding Name}" ToolTip="{Binding FullPath}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Width="110">
                                <GridViewColumn.Header>
                                    <TextBlock FontSize="13" FontWeight="Bold" Foreground="#BBBBBB" Text="{Binding Path=Current.HeaderSize, Source={x:Static l:Loc.Instance}}"/>
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock HorizontalAlignment="Right" Text="{Binding SizeText}" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Width="40">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock HorizontalAlignment="Center" Text="{Binding EncryptedMark}" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>

                <Border BorderBrush="#333337" BorderThickness="1" CornerRadius="6" IsHitTestVisible="False" Margin="15,55,15,15" Visibility="{Binding EntriesHintVisibility}">
                    <Border.Background>
                        <SolidColorBrush Color="#181818" Opacity="0.95"/>
                    </Border.Background>
                    <StackPanel HorizontalAlignment="Center" Opacity="0.85" VerticalAlignment="Center">
                        <Image Height="28" Margin="0,0,0,8" Source="/Assets/Images/Info.png" Width="28"/>
                        <TextBlock FontSize="14" FontWeight="Bold" Foreground="LightGray" HorizontalAlignment="Center" Text="{Binding Path=Current.HintDropPkgFile, Source={x:Static l:Loc.Instance}}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Border Background="#12FFFFFF" BorderBrush="#30FFFFFF" BorderThickness="1" CornerRadius="6" Grid.Row="2" Height="36" Margin="5,0,5,5">
            <Grid>
                <TextBox AllowDrop="True" Background="Transparent" BorderThickness="0" FontSize="11" Foreground="#DCDCDC" IsEnabled="{Binding IsIdle}" Padding="10,0" Text="{Binding License, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center"
                         Drop="License_Drop" PreviewDragOver="License_PreviewDragOver"/>
                <TextBlock FontSize="11" Foreground="#50FFFFFF" IsHitTestVisible="False" Margin="10,0,0,0" Text="{Binding Path=Current.ToolTipLicenseKey, Source={x:Static l:Loc.Instance}}" VerticalAlignment="Center" Visibility="{Binding LicenseHintVisibility}"/>
            </Grid>
        </Border>

        <Grid Grid.Row="3" IsEnabled="{Binding IsIdle}" Margin="5,0,5,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button BorderThickness="1" Command="{Binding AddCommand}" Grid.Column="0" Height="36" Margin="0,0,5,0" Style="{StaticResource GrayButton}">
                <StackPanel Orientation="Horizontal">
                    <Image Height="20" Margin="0,0,6,0" Source="/Assets/Images/AddFile.png" Width="20"/>
                    <TextBlock Text="{Binding Path=Current.ButtonAddFile, Source={x:Static l:Loc.Instance}}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button BorderThickness="1" Command="{Binding ClearCommand}" Grid.Column="1" Height="36" Margin="0,0,5,0" Style="{StaticResource GrayButton}">
                <StackPanel Orientation="Horizontal">
                    <Image Height="20" Margin="0,0,6,0" Source="/Assets/Images/Clear.png" Width="20"/>
                    <TextBlock Text="{Binding Path=Current.ButtonClear, Source={x:Static l:Loc.Instance}}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button x:Name="BtnSaveAll" BorderThickness="1" Click="BtnSaveAll_Click" Grid.Column="2" Height="36" Style="{StaticResource GrayButton}">
                <StackPanel Orientation="Horizontal">
                    <Image Height="20" Margin="0,0,6,0" Source="/Assets/Images/Run.png" Width="20"/>
                    <TextBlock Text="{Binding Path=Current.ButtonSaveAll, Source={x:Static l:Loc.Instance}}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <Border Background="#12FFFFFF" BorderBrush="#30FFFFFF" BorderThickness="0,1,0,0" CornerRadius="8" Grid.Row="4" Margin="5,0,5,5" Padding="8,0">
            <Grid Height="28">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock FontSize="11" Foreground="#A0A0A0" Grid.Column="0" Text="{Binding ProgressLabel}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#4CAF50" Grid.Column="1" Margin="0,0,10,0" Text="{Binding ProgressPercent}" VerticalAlignment="Center"/>
                <TextBlock FontSize="11" Foreground="Gray" Grid.Column="2" Margin="0,0,10,0" Text="{Binding ProgressSpeed}" VerticalAlignment="Center"/>
                <TextBlock FontSize="11" Foreground="#4CAF50" Grid.Column="3" Margin="0,0,10,0" Text="{Binding ProgressTime}" VerticalAlignment="Center"/>
                <Grid Grid.Column="4" Height="10" VerticalAlignment="Center">
                    <Border Background="#25FFFFFF" CornerRadius="5"/>
                    <Border ClipToBounds="True" CornerRadius="5" x:Name="barTrack">
                        <Border Background="#4CAF50" CornerRadius="5" HorizontalAlignment="Left">
                            <Border.Width>
                                <MultiBinding Converter="{StaticResource ProgressToWidthConverter}">
                                    <Binding ElementName="barTrack" Path="ActualWidth"/>
                                    <Binding Path="ProgressPct"/>
                                </MultiBinding>
                            </Border.Width>
                        </Border>
                    </Border>
                </Grid>
                <Button BorderThickness="1" Command="{Binding CancelCommand}" Content="{Binding Path=Current.ButtonCancel, Source={x:Static l:Loc.Instance}}" FontSize="11" Grid.Column="5" IsEnabled="{Binding IsLocked}" Margin="8,0,0,0" Padding="10,0" Style="{StaticResource GrayButton}"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>