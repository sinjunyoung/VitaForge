<UserControl x:Class="VitaForge.Controls.PSVita.DownloadTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:core="clr-namespace:VitaForge.Controls"
             xmlns:l="clr-namespace:Common.Localization;assembly=Common"
             mc:Ignorable="d"
             d:DesignHeight="640" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" IsEnabled="{Binding IsIdle}" Margin="5,0,5,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Background="#12FFFFFF" BorderBrush="#30FFFFFF" BorderThickness="1" CornerRadius="6" Grid.Column="0" Height="36" Margin="0,0,5,0">
                <Grid>
                    <TextBox Background="Transparent" BorderThickness="0" FontSize="12" Foreground="#DCDCDC" Padding="10,0" Text="{Binding SearchTitleId, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                    <TextBlock FontSize="12" Foreground="#50FFFFFF" IsHitTestVisible="False" Margin="10,0,0,0" Text="{Binding Path=Current.HintSearchTitleId, Source={x:Static l:Loc.Instance}}" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SearchTitleId}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SearchTitleId}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>
            <ComboBox Grid.Column="1" Height="36" ItemsSource="{Binding RegionOptions}" SelectedItem="{Binding SelectedRegion, Mode=TwoWay}" DisplayMemberPath="Label" Margin="0,0,5,0" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
            <Border Background="#12FFFFFF" BorderBrush="#30FFFFFF" BorderThickness="1" CornerRadius="6" Grid.Column="2" Height="36" Margin="0,0,5,0">
                <Grid>
                    <TextBox Background="Transparent" BorderThickness="0" FontSize="12" Foreground="#DCDCDC" Padding="10,0" Text="{Binding SearchName, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                    <TextBlock FontSize="12" Foreground="#50FFFFFF" IsHitTestVisible="False" Margin="10,0,0,0" Text="{Binding Path=Current.HintSearchGame, Source={x:Static l:Loc.Instance}}" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SearchName}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SearchName}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>
            <Button BorderThickness="1" Command="{Binding SearchCommand}" Grid.Column="3" Height="36" Padding="14,0" Style="{StaticResource GrayButton}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Height="18" Margin="0,0,6,0" RenderOptions.BitmapScalingMode="HighQuality" Source="/Assets/Images/Search.png" Width="18"/>
                    <TextBlock Text="{Binding Path=Current.ButtonSearch, Source={x:Static l:Loc.Instance}}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <Border Background="#12FFFFFF" BorderBrush="#30FFFFFF" BorderThickness="1" CornerRadius="8" Grid.Row="1" IsEnabled="{Binding IsIdle}" Margin="5,0,5,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="40"/>
                </Grid.ColumnDefinitions>
                <ListView x:Name="LvCatalog" Background="Transparent" BorderThickness="0" GridViewColumnHeader.Click="LvCatalog_HeaderClick" ItemsSource="{Binding Rows}" Margin="5" MouseDoubleClick="LvCatalog_MouseDoubleClick" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" SelectionMode="Single">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsChild}" Value="True">
                                    <Setter Property="Background" Value="#10FFFFFF"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Width="68">
                                <GridViewColumn.Header>
                                    <CheckBox Style="{StaticResource SplitCheckBoxStyle}" Command="{Binding ToggleAllCheckedCommand}" IsChecked="{Binding AllChecked, Mode=OneWay}" IsThreeState="True" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="{Binding Path=Current.ToolTipSelectAllToggle, Source={x:Static l:Loc.Instance}}" />
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel x:Name="selectPanel" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Margin" Value="4,0,0,0" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsChild}" Value="True">
                                                            <Setter Property="Margin" Value="28,0,0,0" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <Grid x:Name="expanderSlot" Width="24" Height="22" VerticalAlignment="Center">
                                                <Button x:Name="btnExpand" Style="{StaticResource SplitExpanderStyle}" Click="BtnExpand_Click" ToolTip="{Binding Path=Current.ToolTipExpandCollapse, Source={x:Static l:Loc.Instance}}">
                                                    <Path x:Name="chevron" Data="M 0,0 L 4,4 L 0,8" Stroke="#BBBBBB" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                                        <Path.RenderTransform>
                                                            <RotateTransform Angle="0" />
                                                        </Path.RenderTransform>
                                                    </Path>
                                                </Button>
                                            </Grid>
                                            <CheckBox Style="{StaticResource SplitCheckBoxStyle}" IsChecked="{Binding IsChecked, Mode=TwoWay}" IsThreeState="False" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,0,0,0" />
                                        </StackPanel>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding ExpandGlyph}" Value="">
                                                <Setter TargetName="btnExpand" Property="Visibility" Value="Hidden" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ExpandGlyph}" Value="{x:Null}">
                                                <Setter TargetName="btnExpand" Property="Visibility" Value="Hidden" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsChild}" Value="True">
                                                <Setter TargetName="expanderSlot" Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                <Setter TargetName="chevron" Property="Stroke" Value="#1C97EA" />
                                                <Setter TargetName="chevron" Property="RenderTransform">
                                                    <Setter.Value>
                                                        <RotateTransform Angle="90" />
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn Width="Auto">
                                <GridViewColumn.Header>
                                    <GridViewColumnHeader Tag="Category">
                                        <Image Height="24" Margin="0,0,4,0" Source="/Assets/Images/Categories.png" Width="24"/>
                                    </GridViewColumnHeader>
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding CategoryBadgeColor}" CornerRadius="4" HorizontalAlignment="Center" Padding="10,3">
                                            <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="White" Text="{Binding Category}"/>
                                        </Border>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn Width="Auto">
                                <GridViewColumn.Header>
                                    <GridViewColumnHeader Tag="TitleId">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Image Source="/Assets/Images/VitaCartridge.png" Width="24" Height="24" Margin="0,0,4,0"/>
                                            <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#BBBBBB" Text="{Binding Path=Current.HeaderTitleId, Source={x:Static l:Loc.Instance}}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </GridViewColumnHeader>
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock FontSize="12" Foreground="#E8E8F0" Text="{Binding TitleId}" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn Width="60">
                                <GridViewColumn.Header>
                                    <GridViewColumnHeader Tag="Region">
                                        <Image Source="/VitaForge.Core;component/Assets/Images/world.png" Width="24" Height="24" Margin="0,0,4,0"/>
                                    </GridViewColumnHeader>
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock FontSize="12" Foreground="#E8E8F0" Text="{Binding Region}" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn Width="300">
                                <GridViewColumn.Header>
                                    <GridViewColumnHeader Tag="Name">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Image Source="/Assets/Images/VitaCartridge.png" Width="24" Height="24" Margin="0,0,4,0"/>
                                            <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#BBBBBB" Text="{Binding Path=Current.LabelGameName, Source={x:Static l:Loc.Instance}}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </GridViewColumnHeader>
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#E8E8F0" Text="{Binding KoreanName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding KoreanName}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasKoreanName}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock FontSize="12" Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                        <Setter Property="Foreground" Value="#E8E8F0"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasKoreanName}" Value="True">
                                                                <Setter Property="FontSize" Value="10"/>
                                                                <Setter Property="FontWeight" Value="Normal"/>
                                                                <Setter Property="Foreground" Value="#8888A8"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn Width="Auto">
                                <GridViewColumn.Header >
                                    <GridViewColumnHeader Tag="Version">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Image Source="/Assets/Images/Version.png" Width="24" Height="24" Margin="0,0,4,0"/>
                                            <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#BBBBBB" Text="{Binding Path=Current.HeaderVersion, Source={x:Static l:Loc.Instance}}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </GridViewColumnHeader>
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock FontSize="12" Foreground="#8888A8" Text="{Binding Version}" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn Width="Auto">
                                <GridViewColumn.Header>
                                    <GridViewColumnHeader Tag="Size">
                                        <Image Source="/Assets/Images/FileSizeBytes.png" Width="24" Height="24" Margin="0,0,4,0"/>
                                    </GridViewColumnHeader>
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Size}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>

                <StackPanel Grid.Column="1" Margin="5" VerticalAlignment="Top">
                    <ToggleButton Style="{StaticResource ToggleStyle}" Height="30" Width="30" Padding="0" Margin="0,0,0,8" HorizontalAlignment="Center" HorizontalContentAlignment="Center" IsChecked="{Binding ShowCheckedOnly, Mode=TwoWay}" IsEnabled="{Binding CanShowCheckedOnly}" ToolTip="{Binding Path=Current.ToolTipShowCheckedOnly, Source={x:Static l:Loc.Instance}}" ToolTipService.ShowOnDisabled="True">
                        <Image Height="24" Width="24" RenderOptions.BitmapScalingMode="HighQuality" Source="{Binding ShowCheckedOnly, Converter={StaticResource BoolToImageConverter}}"/>
                    </ToggleButton>
                    <Button BorderThickness="1" Command="{Binding ClearCheckedCommand}" Height="30" Margin="0,0,0,8" Padding="0" Style="{StaticResource GrayButton}" Width="30">
                        <Image Height="30" RenderOptions.BitmapScalingMode="HighQuality" Source="/Assets/Images/Clear.png" ToolTip="{Binding Path=Current.ToolTipClear, Source={x:Static l:Loc.Instance}}" Width="30"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock FontSize="11" Foreground="#A0A0A0" Grid.Row="2" HorizontalAlignment="Right" Margin="5,0,10,5" Text="{Binding ResultText}"/>

        <StackPanel Grid.Row="3" Margin="5,0,5,5" Orientation="Horizontal">
            <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="White" Margin="0,0,10,0" Text="{Binding Path=Current.LabelOutputFormat, Source={x:Static l:Loc.Instance}}" VerticalAlignment="Center"/>
            <RadioButton Content="{Binding Path=Current.RadioNoNpDrmZipPerTitleId, Source={x:Static l:Loc.Instance}}" FontSize="12" Foreground="White" GroupName="VitaDownloadOutputGroup" IsChecked="{Binding OutputZip}" IsEnabled="{Binding IsIdle}" Margin="0,0,15,0" VerticalAlignment="Center"/>
            <RadioButton Content="{Binding Path=Current.RadioNoNpDrmFolderPerTitleId, Source={x:Static l:Loc.Instance}}" FontSize="12" Foreground="White" GroupName="VitaDownloadOutputGroup" IsChecked="{Binding OutputFolder}" IsEnabled="{Binding IsIdle}" Margin="0,0,15,0" VerticalAlignment="Center"/>
            <Border Background="#555555" Height="16" Margin="0,0,15,0" VerticalAlignment="Center" Width="1"/>
            <RadioButton Content="{Binding Path=Current.RadioOriginalPkg, Source={x:Static l:Loc.Instance}}" FontSize="12" Foreground="White" GroupName="VitaDownloadOutputGroup" IsChecked="{Binding OutputPkg}" IsEnabled="{Binding IsIdle}" VerticalAlignment="Center"/>
        </StackPanel>

        <Grid Grid.Row="4" Margin="5,0,5,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Background="#12FFFFFF" BorderBrush="#30FFFFFF" BorderThickness="1" CornerRadius="6" Grid.Column="0" Height="36">
                <Grid>
                    <TextBox Background="Transparent" BorderThickness="0" FontSize="11" Foreground="#DCDCDC" IsEnabled="{Binding IsIdle}" Padding="10,0" Text="{Binding OutputPath, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center"
                             AllowDrop="True" PreviewDragOver="TxtOutputPath_PreviewDragOver" Drop="TxtOutputPath_Drop"/>
                    <TextBlock FontSize="11" Foreground="#50FFFFFF" IsHitTestVisible="False" Margin="10,0,0,0" Text="{Binding Path=Current.HintDragOrSelectOutputFolder, Source={x:Static l:Loc.Instance}}" VerticalAlignment="Center" Visibility="{Binding OutputHintVisibility}"/>
                </Grid>
            </Border>
            <Button BorderThickness="1" Command="{Binding BrowseOutputCommand}" Grid.Column="1" Height="30" IsEnabled="{Binding IsIdle}" Margin="5,0,0,0" Padding="0" Style="{StaticResource GrayButton}" Width="30">
                <Image Height="30" RenderOptions.BitmapScalingMode="HighQuality" Source="/VitaForge.Core;component/Assets/Images/AddFolder.png" Width="30"/>
            </Button>
        </Grid>

        <core:IconButton Grid.Row="5" Margin="5,0,5,5" DefaultText="{Binding Path=Current.ButtonStart, Source={x:Static l:Loc.Instance}}" DefaultIcon="/Assets/Images/Run.png" CancelText="{Binding Path=Current.ButtonCancel, Source={x:Static l:Loc.Instance}}" CancelIcon="/Assets/Images/Cancel.png" IsRunning="{Binding IsLocked}" Click="BtnStart_Click"/>

        <Border Background="#12FFFFFF" BorderBrush="#30FFFFFF" BorderThickness="0,1,0,0" CornerRadius="8" Grid.Row="6" Margin="5,0,5,5" Padding="8,0">
            <Grid Height="28">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="140"/>
                </Grid.ColumnDefinitions>
                <TextBlock FontSize="11" Foreground="#A0A0A0" Grid.Column="0" Text="{Binding ProgressLabel}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#4CAF50" Grid.Column="1" Margin="0,0,10,0" Text="{Binding ProgressPercent}" VerticalAlignment="Center"/>
                <TextBlock FontSize="11" Foreground="Gray" Grid.Column="2" Margin="0,0,10,0" Text="{Binding ProgressSpeed}" VerticalAlignment="Center"/>
                <TextBlock FontSize="11" Foreground="#4CAF50" Grid.Column="3" Margin="0,0,10,0" Text="{Binding ProgressTime}" VerticalAlignment="Center"/>
                <Grid Grid.Column="4" Height="10" VerticalAlignment="Center">
                    <Border Background="#25FFFFFF" CornerRadius="5"/>
                    <Border ClipToBounds="True" CornerRadius="5" x:Name="barTrack">
                        <Border Background="#4CAF50" CornerRadius="5" HorizontalAlignment="Left">
                            <Border.Width>
                                <MultiBinding Converter="{StaticResource ProgressToWidthConverter}">
                                    <Binding ElementName="barTrack" Path="ActualWidth"/>
                                    <Binding Path="ProgressPct"/>
                                </MultiBinding>
                            </Border.Width>
                        </Border>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>