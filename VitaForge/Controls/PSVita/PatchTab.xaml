<UserControl x:Class="VitaForge.Controls.PSVita.PatchTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:core="clr-namespace:VitaForge.Controls"
             xmlns:l="clr-namespace:Common.Localization;assembly=Common"
             mc:Ignorable="d"
             d:DesignHeight="640" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="#12FFFFFF" BorderBrush="#30FFFFFF" BorderThickness="1" CornerRadius="8" Grid.Row="0" IsEnabled="{Binding IsIdle}" Margin="5,0,5,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="40"/>
                </Grid.ColumnDefinitions>
                <ListView Background="Transparent" BorderThickness="0" ItemsSource="{Binding Rows}" Margin="5" ScrollViewer.CanContentScroll="True" SelectionMode="Single" VirtualizingPanel.IsVirtualizing="True">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Width="48">
                                <GridViewColumn.Header>
                                    <CheckBox Style="{StaticResource SplitCheckBoxStyle}" Command="{Binding ToggleAllCheckedCommand}" IsChecked="{Binding AllChecked, Mode=OneWay}" IsThreeState="True" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="{Binding Path=Current.ToolTipSelectAllToggle, Source={x:Static l:Loc.Instance}}"/>
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox Style="{StaticResource SplitCheckBoxStyle}" IsChecked="{Binding IsChecked, Mode=TwoWay}" IsThreeState="False" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsSelectable, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn Width="Auto">
                                <GridViewColumn.Header>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Image Source="/Assets/Images/VitaCartridge.png" Width="24" Height="24" Margin="0,0,4,0"/>
                                        <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#BBBBBB" Text="ID" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock FontSize="12" Foreground="#E8E8F0" Text="{Binding TitleId}" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn Width="56">
                                <GridViewColumn.Header>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Image Source="/VitaForge.Core;component/Assets/Images/world.png" Width="24" Height="24" Margin="0,0,4,0"/>
                                    </StackPanel>
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock FontSize="12" Foreground="#E8E8F0" Text="{Binding Region}" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn Width="Auto">
                                <GridViewColumn.Header>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Image Source="/Assets/Images/VitaCartridge.png" Width="24" Height="24" Margin="0,0,4,0"/>
                                        <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#BBBBBB" Text="{Binding Path=Current.HeaderTitle, Source={x:Static l:Loc.Instance}}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#E8E8F0" Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn Width="Auto">
                                <GridViewColumn.Header>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Image Source="/Assets/Images/Patch.png" Width="24" Height="24" Margin="0,0,4,0"/>
                                        <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#BBBBBB" Text="{Binding Path=Current.HeaderVersion, Source={x:Static l:Loc.Instance}}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock FontSize="12" Foreground="#8888A8" Text="{Binding Version}" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn Width="Auto">
                                <GridViewColumn.Header>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Image Source="/VitaForge.Core;component/Assets/Images/Version.png" Width="24" Height="24" Margin="0,0,4,0"/>
                                        <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#BBBBBB" Text="{Binding Path=Current.HeaderRequiredUpdate, Source={x:Static l:Loc.Instance}}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock FontSize="12" Foreground="#8888A8" Text="{Binding RequiredUpdate}" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn Width="Auto">
                                <GridViewColumn.Header>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Image Source="/Assets/Images/Categories.png" Width="24" Height="24" Margin="0,0,4,0"/>
                                    </StackPanel>
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding PatchTypeBadgeColor}" CornerRadius="4" HorizontalAlignment="Center" Padding="10,3">
                                            <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="White" Text="{Binding PatchType}"/>
                                        </Border>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn Width="44">
                                <GridViewColumn.Header>
                                    <Image Source="/Assets/Images/Link.png" Width="24" Height="24"/>
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button BorderThickness="1" Click="BtnReleaseLink_Click" Height="22" Padding="0" Width="28"
                                                Style="{StaticResource GrayButton}" ToolTip="{Binding Path=Current.ToolTipOpenReleasePage, Source={x:Static l:Loc.Instance}}" Visibility="{Binding HasReleaseLink, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Image Source="/Assets/Images/Link.png" Width="12" Height="12"/>
                                        </Button>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>

                <StackPanel Grid.Column="1" Margin="5" VerticalAlignment="Top">
                    <Button BorderThickness="1" Command="{Binding ClearCheckedCommand}" Height="30" Margin="0,0,0,8" Padding="0" Style="{StaticResource GrayButton}" Width="30">
                        <Image Height="30" RenderOptions.BitmapScalingMode="HighQuality" Source="/Assets/Images/Clear.png" ToolTip="{Binding Path=Current.ToolTipClear, Source={x:Static l:Loc.Instance}}" Width="30"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock FontSize="11" Foreground="#A0A0A0" Grid.Row="1" HorizontalAlignment="Right" Margin="5,0,10,5" Text="{Binding ResultText}"/>

        <StackPanel Grid.Row="2" Margin="5,0,5,5" Orientation="Horizontal">
            <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="White" Margin="0,0,10,0" Text="{Binding Path=Current.LabelPatchMode, Source={x:Static l:Loc.Instance}}" VerticalAlignment="Center"/>
            <RadioButton Content="{Binding Path=Current.RadioModeInstall, Source={x:Static l:Loc.Instance}}" FontSize="12" Foreground="White" GroupName="VitaPatchModeGroup" IsChecked="{Binding ModeInstall}" IsEnabled="{Binding IsIdle}" Margin="0,0,15,0" VerticalAlignment="Center"/>
            <RadioButton Content="{Binding Path=Current.RadioModeArchive, Source={x:Static l:Loc.Instance}}" FontSize="12" Foreground="White" GroupName="VitaPatchModeGroup" IsChecked="{Binding ModeArchive}" IsEnabled="{Binding IsIdle}" Margin="0,0,15,0" VerticalAlignment="Center"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="5,0,5,5" Orientation="Horizontal">
            <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="White" Margin="0,0,10,0" Text="{Binding Path=Current.LabelInstallTarget, Source={x:Static l:Loc.Instance}}" VerticalAlignment="Center"/>
            <RadioButton Content="{Binding Path=Current.RadioInstallVita3k, Source={x:Static l:Loc.Instance}}" FontSize="12" Foreground="White" GroupName="VitaPatchInstallGroup" IsChecked="{Binding InstallEmu}" IsEnabled="{Binding IsIdle}" Margin="0,0,15,0" VerticalAlignment="Center"/>
            <RadioButton Content="{Binding Path=Current.RadioInstallDevice, Source={x:Static l:Loc.Instance}}" FontSize="12" Foreground="White" GroupName="VitaPatchInstallGroup" IsChecked="{Binding InstallDevice}" IsEnabled="{Binding IsIdle}" Margin="0,0,15,0" VerticalAlignment="Center"/>
            <Border Background="#555555" Height="16" Margin="0,0,15,0" VerticalAlignment="Center" Width="1"/>
            <CheckBox Content="{Binding Path=Current.CheckIncludeDlc, Source={x:Static l:Loc.Instance}}" FontSize="12" Foreground="White" IsChecked="{Binding IncludeDlc}" IsEnabled="{Binding IsIdle}" VerticalAlignment="Center"/>
        </StackPanel>

        <Grid Grid.Row="4" Margin="5,0,5,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Background="#12FFFFFF" BorderBrush="#30FFFFFF" BorderThickness="1" CornerRadius="6" Grid.Column="0" Height="36">
                <Grid>
                    <TextBox Background="Transparent" BorderThickness="0" FontSize="11" Foreground="#DCDCDC" IsEnabled="{Binding IsIdle}" Padding="10,0" Text="{Binding TargetPath, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center"
                             AllowDrop="True" PreviewDragOver="TxtTargetPath_PreviewDragOver" Drop="TxtTargetPath_Drop"/>
                    <TextBlock FontSize="11" Foreground="#50FFFFFF" IsHitTestVisible="False" Margin="10,0,0,0" Text="{Binding Path=Current.HintVita3kFolder, Source={x:Static l:Loc.Instance}}" VerticalAlignment="Center" Visibility="{Binding EmuHintVisibility}"/>
                    <TextBlock FontSize="11" Foreground="#50FFFFFF" IsHitTestVisible="False" Margin="10,0,0,0" Text="{Binding Path=Current.HintDeviceRoot, Source={x:Static l:Loc.Instance}}" VerticalAlignment="Center" Visibility="{Binding DeviceHintVisibility}"/>
                    <TextBlock FontSize="11" Foreground="#50FFFFFF" IsHitTestVisible="False" Margin="10,0,0,0" Text="{Binding Path=Current.HintPatchOutputFolder, Source={x:Static l:Loc.Instance}}" VerticalAlignment="Center" Visibility="{Binding OutputHintVisibility}"/>
                </Grid>
            </Border>
            <Button BorderThickness="1" Command="{Binding BrowseTargetCommand}" Grid.Column="1" Height="30" IsEnabled="{Binding IsIdle}" Margin="5,0,0,0" Padding="0" Style="{StaticResource GrayButton}" Width="30">
                <Image Height="30" RenderOptions.BitmapScalingMode="HighQuality" Source="/VitaForge.Core;component/Assets/Images/AddFolder.png" Width="30"/>
            </Button>
        </Grid>

        <core:IconButton Grid.Row="5" Margin="5,0,5,5" DefaultText="{Binding Path=Current.ButtonStart, Source={x:Static l:Loc.Instance}}" DefaultIcon="/Assets/Images/Run.png" CancelText="{Binding Path=Current.ButtonCancel, Source={x:Static l:Loc.Instance}}" CancelIcon="/Assets/Images/Cancel.png" IsRunning="{Binding IsLocked}" Click="BtnStart_Click"/>

        <Border Background="#12FFFFFF" BorderBrush="#30FFFFFF" BorderThickness="0,1,0,0" CornerRadius="8" Grid.Row="6" Margin="5,0,5,5" Padding="8,0">
            <Grid Height="28">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="140"/>
                </Grid.ColumnDefinitions>
                <TextBlock FontSize="11" Foreground="#A0A0A0" Grid.Column="0" Text="{Binding ProgressLabel}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#4CAF50" Grid.Column="1" Margin="0,0,10,0" Text="{Binding ProgressPercent}" VerticalAlignment="Center"/>
                <TextBlock FontSize="11" Foreground="Gray" Grid.Column="2" Margin="0,0,10,0" Text="{Binding ProgressSpeed}" VerticalAlignment="Center"/>
                <TextBlock FontSize="11" Foreground="#4CAF50" Grid.Column="3" Margin="0,0,10,0" Text="{Binding ProgressTime}" VerticalAlignment="Center"/>
                <Grid Grid.Column="4" Height="10" VerticalAlignment="Center">
                    <Border Background="#25FFFFFF" CornerRadius="5"/>
                    <Border ClipToBounds="True" CornerRadius="5" x:Name="barTrack">
                        <Border Background="#4CAF50" CornerRadius="5" HorizontalAlignment="Left">
                            <Border.Width>
                                <MultiBinding Converter="{StaticResource ProgressToWidthConverter}">
                                    <Binding ElementName="barTrack" Path="ActualWidth"/>
                                    <Binding Path="ProgressPct"/>
                                </MultiBinding>
                            </Border.Width>
                        </Border>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>